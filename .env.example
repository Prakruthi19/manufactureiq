# Copy to .env and fill in. On Render these are set via the dashboard / render.yaml.

OPENAI_API_KEY=sk-...

# Local dev: Docker Redis. On Render this is injected from the miq-redis service.
REDIS_URL=redis://localhost:6379/0

# ChromaDB persistence + embedder cache
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_CACHE_DIR=./.cache_home

# Silence library telemetry (prevents Celery worker shutdown crashes)
ANONYMIZED_TELEMETRY=False
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
LITELLM_TELEMETRY=False
